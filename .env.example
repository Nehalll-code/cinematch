# Copy to .env (git-ignored). Used by docker compose and, if you export them, by the app.
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=cinematch_dev
POSTGRES_DB=cinematch

DATABASE_URL=postgresql+psycopg://cinematch:cinematch_dev@127.0.0.1:5432/cinematch
CINEMATCH_TEST_DATABASE_URL=postgresql+psycopg://cinematch:cinematch_dev@127.0.0.1:5432/cinematch_test

# Required by the API; there is deliberately no default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CINEMATCH_JWT_SECRET=
